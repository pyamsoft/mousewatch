{
  "name": "mousewatch",
  "version": "2.3.1",
  "main": "index.js",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite-node --mode development ./src/index.js",
    "prod": "vite-node --mode production ./src/index.js",
    "lint:eslint": "eslint --report-unused-disable-directives --max-warnings 0 --cache --cache-strategy content .",
    "lint:oxlint": "oxlint --deny-warnings .",
    "lint:tsc": "tsc --strict --noEmit",
    "lint": "$npm_execpath run lint:oxlint && $npm_execpath run lint:tsc && $npm_execpath run lint:eslint",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=24.x"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "dotenv": "18.0.5",
    "luxon": "3.7.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@types/luxon": "3.7.6",
    "@types/node": "26.6.4",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "npm-check-updates": "23.1.0",
    "oxlint": "1.86.0",
    "prettier": "3.9.9",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite-node": "6.0.0"
  },
  "packageManager": "pnpm@12.8.1"
}
